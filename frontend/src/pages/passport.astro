---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import { PRESETS } from '../lib/mockData';

const p = PRESETS.ramesh;
---

<DashboardLayout
  title="Digital Financial Passport"
  activeNav="passport"
  applicantName={p.name}
  businessName={p.business}
  statusBadge="PASSPORT READY"
>
  <div class="space-y-8 max-w-4xl mx-auto">
    <!-- Top Header & Action -->
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pb-2">
      <div>
        <span class="text-xs uppercase font-mono tracking-wider text-lime">Portable Credit Dossier</span>
        <h2 class="text-2xl font-bold text-white mt-0.5">Digital Financial Passport</h2>
        <p class="text-xs text-text-secondary mt-1">
          An applicant-owned, verifiable financial dossier synthesized from consented digital statements.
        </p>
      </div>

      <a
        href="http://localhost:8000/api/reports/demo/download"
        target="_blank"
        class="btn-lime text-xs py-2.5 px-5 flex items-center gap-2 shadow-lime-glow"
      >
        <span>↓</span> Download Official PDF Dossier
      </a>
    </div>

    <!-- Passport Document Card Preview -->
    <div class="bg-[#121316] border-2 border-lime/30 rounded-3xl p-8 sm:p-10 shadow-2xl relative overflow-hidden">
      <!-- Watermark / Stamp -->
      <div class="absolute -right-10 -bottom-10 w-60 h-60 bg-lime/5 rounded-full blur-2xl pointer-events-none"></div>

      <!-- Passport Header Banner -->
      <div class="flex items-start justify-between pb-6 border-b border-[#22252B]">
        <div>
          <div class="flex items-center gap-2">
            <div class="w-6 h-6 rounded bg-lime flex items-center justify-center font-bold text-black text-xs">✦</div>
            <span class="text-base font-bold text-white tracking-wider">EQUISCORE FINANCIAL PASSPORT</span>
          </div>
          <p class="text-[11px] text-lime font-mono mt-1">VERIFIABLE ALTERNATIVE CREDIT & INCOME DOSSIER</p>
        </div>
        <div class="text-right">
          <span class="text-[10px] text-text-muted font-mono block">DOSSIER ID</span>
          <span class="num-mono text-xs font-bold text-white">PASSPORT-IND-04821</span>
        </div>
      </div>

      <!-- Identity & Enterprise Row -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 py-6 border-b border-[#22252B] text-xs">
        <div>
          <span class="text-text-muted block text-[11px]">Applicant Name</span>
          <span class="font-bold text-white mt-0.5 block">{p.name}</span>
        </div>
        <div>
          <span class="text-text-muted block text-[11px]">Trade / Enterprise</span>
          <span class="font-bold text-white mt-0.5 block">{p.business}</span>
        </div>
        <div>
          <span class="text-text-muted block text-[11px]">Statement Coverage</span>
          <span class="font-bold text-white mt-0.5 block">4 Months Verified</span>
        </div>
        <div>
          <span class="text-text-muted block text-[11px]">Lending Status</span>
          <span class="text-positive font-bold mt-0.5 block">✓ {p.decision}</span>
        </div>
      </div>

      <!-- Scoring Snapshot Highlight -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 my-6">
        <div class="p-5 bg-[#16181D] border border-lime/30 rounded-2xl flex items-center justify-between">
          <div>
            <span class="text-[11px] font-mono uppercase text-text-muted">Financial Health Score</span>
            <p class="num-mono text-3xl font-extrabold text-lime mt-1">{p.fhs} <span class="text-xs text-text-muted font-normal">/ 100</span></p>
            <p class="text-xs text-white mt-0.5">Prime Stable Band</p>
          </div>
          <span class="text-3xl">🛡️</span>
        </div>

        <div class="p-5 bg-[#16181D] border border-[#22252B] rounded-2xl flex items-center justify-between">
          <div>
            <span class="text-[11px] font-mono uppercase text-text-muted">Alternative Repayment Probability</span>
            <p class="num-mono text-3xl font-extrabold text-white mt-1">{p.prob}%</p>
            <p class="text-xs text-lime mt-0.5">Tier 1 Low Default Risk</p>
          </div>
          <span class="text-3xl">📊</span>
        </div>
      </div>

      <!-- Cashflow Breakdown Summary -->
      <div class="space-y-3 pt-2">
        <h4 class="text-xs font-bold text-white uppercase tracking-wider">Synthesized Cashflow Breakdown</h4>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs">
          <div class="p-3 bg-[#0A0B0D] rounded-xl border border-[#22252B]">
            <span class="text-text-muted text-[10px] block">Monthly Gross</span>
            <span class="num-mono font-bold text-white text-sm">₹{p.gross.toLocaleString()}</span>
          </div>
          <div class="p-3 bg-[#0A0B0D] rounded-xl border border-[#22252B]">
            <span class="text-text-muted text-[10px] block">Operating Expenses</span>
            <span class="num-mono font-bold text-text-secondary text-sm">₹{p.expenses.toLocaleString()}</span>
          </div>
          <div class="p-3 bg-[#0A0B0D] rounded-xl border border-[#22252B]">
            <span class="text-text-muted text-[10px] block">Net Operating Surplus</span>
            <span class="num-mono font-bold text-lime text-sm">₹{p.surplus.toLocaleString()}</span>
          </div>
          <div class="p-3 bg-[#0A0B0D] rounded-xl border border-[#22252B]">
            <span class="text-text-muted text-[10px] block">Cashflow Volatility</span>
            <span class="num-mono font-bold text-white text-sm">{p.cv} (Stable)</span>
          </div>
        </div>
      </div>

      <!-- Integrity Verification Hash & Disclaimer -->
      <div class="mt-8 pt-6 border-t border-[#22252B] space-y-2">
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2 text-[10px] text-text-muted">
          <span>SHA-256 Tamper-Evident Verification Hash:</span>
          <span class="font-mono text-lime break-all">a4f91b7e0892c5d33a1e908f51a702b8d4e92c68f1234abcd567890ef1234567</span>
        </div>
        <p class="text-[10px] text-text-muted leading-relaxed">
          Notice: This document is an explainable alternative credit assessment derived from consented transaction records. It does not replace an authorized financial bureau rating.
        </p>
      </div>
    </div>
  </div>
</DashboardLayout>
