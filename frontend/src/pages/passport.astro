---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import { PRESETS } from '../lib/mockData';

const p = PRESETS.ramesh;
---

<DashboardLayout
  title="Digital Financial Passport"
  activeNav="passport"
  applicantName={p.name}
  businessName={p.business}
  statusBadge="PASSPORT READY"
>
  <div class="space-y-8 max-w-4xl mx-auto">
    <!-- Top Header & Action -->
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pb-2">
      <div>
        <span class="text-xs uppercase font-mono tracking-wider text-neutral-400">Portable Credit Dossier</span>
        <h2 class="text-2xl font-bold text-white mt-0.5">Digital Financial Passport</h2>
        <p class="text-xs text-text-secondary mt-1 font-light">
          An applicant-owned, verifiable financial dossier synthesized from consented digital statements.
        </p>
      </div>

      <a
        href="http://localhost:8000/api/reports/demo/download"
        target="_blank"
        class="btn-white text-xs py-2.5 px-5 flex items-center gap-2 shadow-white-glow"
      >
        <span>↓</span> Download Official PDF Dossier
      </a>
    </div>

    <!-- Passport Document Card Preview - Monochrome -->
    <div class="bg-[#0A0A0A] border-2 border-white/20 rounded-3xl p-8 sm:p-10 shadow-2xl relative overflow-hidden">
      <!-- Watermark Ambient Blur -->
      <div class="absolute -right-10 -bottom-10 w-60 h-60 bg-white/[0.02] rounded-full blur-2xl pointer-events-none"></div>

      <!-- Passport Header Banner -->
      <div class="flex items-start justify-between pb-6 border-b border-[#222222]">
        <div>
          <div class="flex items-center gap-2">
            <div class="w-6 h-6 rounded bg-white flex items-center justify-center font-bold text-black text-xs">✦</div>
            <span class="text-base font-bold text-white tracking-wider">EQUISCORE FINANCIAL PASSPORT</span>
          </div>
          <p class="text-[11px] text-neutral-400 font-mono mt-1">VERIFIABLE ALTERNATIVE CREDIT & INCOME DOSSIER</p>
        </div>
        <div class="text-right">
          <span class="text-[10px] text-neutral-500 font-mono block">DOSSIER ID</span>
          <span class="num-mono text-xs font-bold text-white">PASSPORT-IND-04821</span>
        </div>
      </div>

      <!-- Identity & Enterprise Row -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 py-6 border-b border-[#222222] text-xs">
        <div>
          <span class="text-neutral-500 block text-[11px]">Applicant Name</span>
          <span class="font-bold text-white mt-0.5 block">{p.name}</span>
        </div>
        <div>
          <span class="text-neutral-500 block text-[11px]">Trade / Enterprise</span>
          <span class="font-bold text-white mt-0.5 block">{p.business}</span>
        </div>
        <div>
          <span class="text-neutral-500 block text-[11px]">Statement Coverage</span>
          <span class="font-bold text-white mt-0.5 block font-mono">4 Months Verified</span>
        </div>
        <div>
          <span class="text-neutral-500 block text-[11px]">Lending Status</span>
          <span class="text-white font-bold mt-0.5 block font-mono">✓ {p.decision}</span>
        </div>
      </div>

      <!-- Scoring Snapshot Highlight -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 my-6">
        <div class="p-5 bg-black border border-white/20 rounded-2xl flex items-center justify-between">
          <div>
            <span class="text-[11px] font-mono uppercase text-neutral-400">Financial Health Score</span>
            <p class="num-mono text-3xl font-extrabold text-white mt-1">{p.fhs} <span class="text-xs text-neutral-500 font-normal">/ 100</span></p>
            <p class="text-xs text-neutral-300 mt-0.5 font-mono">Prime Stable Band</p>
          </div>
          <span class="text-2xl font-mono text-white">▣</span>
        </div>

        <div class="p-5 bg-black border border-[#222222] rounded-2xl flex items-center justify-between">
          <div>
            <span class="text-[11px] font-mono uppercase text-neutral-400">Alternative Repayment Probability</span>
            <p class="num-mono text-3xl font-extrabold text-white mt-1">{p.prob}%</p>
            <p class="text-xs text-neutral-300 mt-0.5 font-mono">Tier 1 Low Default Risk</p>
          </div>
          <span class="text-2xl font-mono text-white">▲</span>
        </div>
      </div>

      <!-- Cashflow Breakdown Summary -->
      <div class="space-y-3 pt-2">
        <h4 class="text-xs font-bold text-white uppercase tracking-wider font-mono">Synthesized Cashflow Breakdown</h4>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs">
          <div class="p-3 bg-black rounded-xl border border-[#222222]">
            <span class="text-neutral-500 text-[10px] block font-mono">Monthly Gross</span>
            <span class="num-mono font-bold text-white text-sm">₹{p.gross.toLocaleString()}</span>
          </div>
          <div class="p-3 bg-black rounded-xl border border-[#222222]">
            <span class="text-neutral-500 text-[10px] block font-mono">Operating Expenses</span>
            <span class="num-mono font-bold text-neutral-300 text-sm">₹{p.expenses.toLocaleString()}</span>
          </div>
          <div class="p-3 bg-black rounded-xl border border-[#222222]">
            <span class="text-neutral-500 text-[10px] block font-mono">Net Operating Surplus</span>
            <span class="num-mono font-bold text-white text-sm">₹{p.surplus.toLocaleString()}</span>
          </div>
          <div class="p-3 bg-black rounded-xl border border-[#222222]">
            <span class="text-neutral-500 text-[10px] block font-mono">Cashflow Volatility</span>
            <span class="num-mono font-bold text-white text-sm">{p.cv} (Stable)</span>
          </div>
        </div>
      </div>

      <!-- Integrity Verification Hash & Disclaimer -->
      <div class="mt-8 pt-6 border-t border-[#222222] space-y-2">
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2 text-[10px] text-neutral-500">
          <span>SHA-256 Tamper-Evident Verification Hash:</span>
          <span class="font-mono text-white break-all">a4f91b7e0892c5d33a1e908f51a702b8d4e92c68f1234abcd567890ef1234567</span>
        </div>
        <p class="text-[10px] text-neutral-500 leading-relaxed font-light">
          Notice: This document is an explainable alternative credit assessment derived from consented transaction records. It does not replace an authorized financial bureau rating.
        </p>
      </div>
    </div>
  </div>
</DashboardLayout>
