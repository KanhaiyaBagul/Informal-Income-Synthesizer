---
import DashboardLayout from '../layouts/DashboardLayout.astro';
---

<DashboardLayout
  title="Model Governance & Fairness Audit"
  activeNav="fairness"
  applicantName="Model Auditor"
  businessName="Ethical AI Governance Office"
  statusBadge="AUDIT PASSED"
>
  <div class="space-y-8">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pb-2">
      <div>
        <span class="text-xs uppercase font-mono tracking-wider text-lime">Fairlearn Algorithmic Audit</span>
        <h2 class="text-2xl font-bold text-white mt-0.5">Demographic Disparity & Bias Governance Portal</h2>
        <p class="text-xs text-text-secondary mt-1">
          Evaluating model fairness across protected attributes without leaking sensitive features into training.
        </p>
      </div>

      <div class="flex items-center gap-2">
        <span class="px-3 py-1 rounded-full text-xs font-mono font-semibold bg-[#16181D] border border-[#22252B] text-lime">
          Model: XGBoost-AltCredit-v1.0
        </span>
      </div>
    </div>

    <!-- KPI Metric Cards for Disparity Metrics -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      <div class="card-meiro">
        <div class="flex items-center justify-between text-xs text-text-secondary mb-2">
          <span>Gender Parity Diff</span>
          <span class="text-positive font-bold text-xs">✓ PASSED</span>
        </div>
        <p class="num-mono text-3xl font-extrabold text-white">0.0156</p>
        <p class="text-[11px] text-text-muted mt-1">Threshold &lt; 0.10 (Fairlearn)</p>
      </div>

      <div class="card-meiro">
        <div class="flex items-center justify-between text-xs text-text-secondary mb-2">
          <span>Equalized Odds Diff</span>
          <span class="text-positive font-bold text-xs">✓ PASSED</span>
        </div>
        <p class="num-mono text-3xl font-extrabold text-white">0.0355</p>
        <p class="text-[11px] text-text-muted mt-1">True Positive Rate parity</p>
      </div>

      <div class="card-meiro">
        <div class="flex items-center justify-between text-xs text-text-secondary mb-2">
          <span>Geographic Parity Diff</span>
          <span class="text-positive font-bold text-xs">✓ PASSED</span>
        </div>
        <p class="num-mono text-3xl font-extrabold text-white">0.0047</p>
        <p class="text-[11px] text-text-muted mt-1">Tier 1 vs Tier 2 vs Rural</p>
      </div>

      <div class="card-meiro">
        <div class="flex items-center justify-between text-xs text-text-secondary mb-2">
          <span>Audited Sample Cohort</span>
          <span class="text-lime font-bold text-xs">VERIFIED</span>
        </div>
        <p class="num-mono text-3xl font-extrabold text-lime">5,000</p>
        <p class="text-[11px] text-text-muted mt-1">Synthetic micro-borrowers</p>
      </div>
    </div>

    <!-- Cohort Disparity Breakdown Table -->
    <div class="bg-[#16181D] border border-[#22252B] rounded-2xl overflow-hidden shadow-card-subtle">
      <div class="p-6 border-b border-[#22252B]">
        <h3 class="text-base font-bold text-white">Group-Level Selection & Error Rate Breakdowns</h3>
        <p class="text-xs text-text-secondary mt-0.5">Audited using Fairlearn MetricFrame across demographic slices.</p>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs">
          <thead class="bg-[#121316] text-text-secondary uppercase tracking-wider text-[11px] border-b border-[#22252B]">
            <tr>
              <th class="py-3 px-6 font-semibold">Sensitive Cohort</th>
              <th class="py-3 px-6 font-semibold">Sample Size</th>
              <th class="py-3 px-6 font-semibold">Selection Rate</th>
              <th class="py-3 px-6 font-semibold">Accuracy</th>
              <th class="py-3 px-6 font-semibold">False Positive Rate</th>
              <th class="py-3 px-6 font-semibold">Compliance Status</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[#22252B]/60 font-medium">
            <tr class="hover:bg-[#1C1F26]/60 transition-colors">
              <td class="py-4 px-6 text-white font-semibold">Female Borrowers</td>
              <td class="py-4 px-6 font-mono text-text-secondary">1,900 (38%)</td>
              <td class="py-4 px-6 font-mono text-white">68.2%</td>
              <td class="py-4 px-6 font-mono text-white">66.8%</td>
              <td class="py-4 px-6 font-mono text-text-secondary">28.4%</td>
              <td class="py-4 px-6"><span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-positive/10 text-positive border border-positive/20">PASSED</span></td>
            </tr>
            <tr class="hover:bg-[#1C1F26]/60 transition-colors">
              <td class="py-4 px-6 text-white font-semibold">Male Borrowers</td>
              <td class="py-4 px-6 font-mono text-text-secondary">3,100 (62%)</td>
              <td class="py-4 px-6 font-mono text-white">69.8%</td>
              <td class="py-4 px-6 font-mono text-white">66.2%</td>
              <td class="py-4 px-6 font-mono text-text-secondary">27.9%</td>
              <td class="py-4 px-6"><span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-positive/10 text-positive border border-positive/20">PASSED</span></td>
            </tr>
            <tr class="hover:bg-[#1C1F26]/60 transition-colors">
              <td class="py-4 px-6 text-white font-semibold">Tier 1 Metro Region</td>
              <td class="py-4 px-6 font-mono text-text-secondary">2,250 (45%)</td>
              <td class="py-4 px-6 font-mono text-white">69.1%</td>
              <td class="py-4 px-6 font-mono text-white">66.5%</td>
              <td class="py-4 px-6 font-mono text-text-secondary">28.1%</td>
              <td class="py-4 px-6"><span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-positive/10 text-positive border border-positive/20">PASSED</span></td>
            </tr>
            <tr class="hover:bg-[#1C1F26]/60 transition-colors">
              <td class="py-4 px-6 text-white font-semibold">Tier 2 Urban Region</td>
              <td class="py-4 px-6 font-mono text-text-secondary">1,750 (35%)</td>
              <td class="py-4 px-6 font-mono text-white">68.9%</td>
              <td class="py-4 px-6 font-mono text-white">66.4%</td>
              <td class="py-4 px-6 font-mono text-text-secondary">28.0%</td>
              <td class="py-4 px-6"><span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-positive/10 text-positive border border-positive/20">PASSED</span></td>
            </tr>
            <tr class="hover:bg-[#1C1F26]/60 transition-colors">
              <td class="py-4 px-6 text-white font-semibold">Tier 3 Rural Region</td>
              <td class="py-4 px-6 font-mono text-text-secondary">1,000 (20%)</td>
              <td class="py-4 px-6 font-mono text-white">69.4%</td>
              <td class="py-4 px-6 font-mono text-white">66.7%</td>
              <td class="py-4 px-6 font-mono text-text-secondary">28.3%</td>
              <td class="py-4 px-6"><span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-positive/10 text-positive border border-positive/20">PASSED</span></td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Governance Ethics Note -->
    <div class="p-6 bg-[#121316] border border-[#22252B] rounded-2xl text-xs space-y-2">
      <h4 class="font-bold text-white flex items-center gap-2">
        <span>🛡️</span> Algorithmic Governance Policy
      </h4>
      <p class="text-text-secondary leading-relaxed">
        Under Fair Lending regulations, alternative credit scoring models must undergo routine fairness audits. Sensitive demographic traits (gender, geography, business category) are strictly excluded from model feature sets during training and inference. They are used exclusively by authorized auditors to compute post-hoc disparity metrics and verify non-discrimination.
      </p>
    </div>
  </div>
</DashboardLayout>
