<header class="sticky top-0 z-50 bg-[#0A0B0D]/80 backdrop-blur-md border-b border-[#22252B]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-2.5 group">
      <div class="w-8 h-8 rounded-lg bg-lime flex items-center justify-center font-bold text-black text-lg transition-transform group-hover:scale-105 shadow-lime-glow">
        ✦
      </div>
      <div class="flex items-baseline gap-1.5">
        <span class="text-xl font-bold tracking-tight text-white font-sans">Equi<span class="text-lime">Score</span></span>
        <span class="text-[10px] tracking-wider uppercase font-semibold text-lime px-2 py-0.5 rounded-full bg-lime/10 border border-lime/20">XAI</span>
      </div>
    </a>

    <!-- Navigation Links -->
    <nav class="hidden md:flex items-center gap-7 text-sm font-medium text-text-secondary">
      <a href="#features" class="hover:text-white transition-colors">Features</a>
      <a href="#how-it-works" class="hover:text-white transition-colors">How It Works</a>
      <a href="/dashboard" class="hover:text-white transition-colors">Live Dashboard</a>
      <a href="/simulator" class="hover:text-white transition-colors">What-If Sandbox</a>
      <a href="/fairness" class="hover:text-white transition-colors">Fairness Audit</a>
      <a href="/passport" class="hover:text-white transition-colors">Financial Passport</a>
    </nav>

    <!-- Action Buttons -->
    <div class="flex items-center gap-3">
      <a href="/dashboard" class="hidden sm:inline-flex btn-dark text-xs py-2 px-4">
        Sign In
      </a>
      <a href="/dashboard" class="btn-lime text-xs py-2 px-4">
        <span>+</span> Open Live Dashboard
      </a>
    </div>
  </div>
</header>
