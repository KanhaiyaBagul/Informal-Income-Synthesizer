---
import '../styles/global.css';

interface Props {
  title?: string;
  activeNav?: string;
  applicantName?: string;
  businessName?: string;
  statusBadge?: string;
}

const {
  title = "Applicant Analytics Dashboard",
  activeNav = "dashboard",
  applicantName = "Ramesh Kumar",
  businessName = "Shree Balaji Chai Stall",
  statusBadge = "ELIGIBLE"
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — EquiScore</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>
  <body class="bg-[#0A0B0D] text-white min-h-screen antialiased flex overflow-x-hidden selection:bg-lime selection:text-black">
    <!-- Meiro Sidebar -->
    <aside class="w-64 bg-[#121316] border-r border-[#22252B] flex flex-col justify-between shrink-0 min-h-screen p-4 hidden md:flex sticky top-0 h-screen">
      <div>
        <!-- Brand -->
        <a href="/" class="flex items-center gap-2.5 px-2 mb-6 group">
          <div class="w-7 h-7 rounded bg-lime flex items-center justify-center font-bold text-black text-sm shadow-lime-glow">✦</div>
          <span class="text-lg font-bold tracking-tight text-white">Equi<span class="text-lime">Score</span></span>
        </a>

        <!-- Action Button -->
        <a href="/dashboard?persona=ramesh" class="btn-lime w-full text-xs py-2.5 mb-6 flex items-center justify-center gap-1.5 shadow-lime-glow">
          <span>+</span> New Assessment
        </a>

        <!-- Navigation Links -->
        <nav class="space-y-1 text-xs font-medium">
          <a
            href="/dashboard"
            class={`flex items-center gap-3 px-3 py-2.5 rounded-xl transition-all ${
              activeNav === 'dashboard'
                ? 'bg-[#1C1F26] text-white border border-[#262A33] font-semibold'
                : 'text-text-secondary hover:text-white hover:bg-[#16181D]'
            }`}
          >
            <span class="text-sm">📊</span> Dashboard & Synthesis
          </a>

          <a
            href="/simulator"
            class={`flex items-center gap-3 px-3 py-2.5 rounded-xl transition-all ${
              activeNav === 'simulator'
                ? 'bg-[#1C1F26] text-white border border-[#262A33] font-semibold'
                : 'text-text-secondary hover:text-white hover:bg-[#16181D]'
            }`}
          >
            <span class="text-sm">🔄</span> What-If Simulator
          </a>

          <a
            href="/fairness"
            class={`flex items-center gap-3 px-3 py-2.5 rounded-xl transition-all ${
              activeNav === 'fairness'
                ? 'bg-[#1C1F26] text-white border border-[#262A33] font-semibold'
                : 'text-text-secondary hover:text-white hover:bg-[#16181D]'
            }`}
          >
            <span class="text-sm">🛡️</span> Fairness & Bias Audit
          </a>

          <a
            href="/passport"
            class={`flex items-center gap-3 px-3 py-2.5 rounded-xl transition-all ${
              activeNav === 'passport'
                ? 'bg-[#1C1F26] text-white border border-[#262A33] font-semibold'
                : 'text-text-secondary hover:text-white hover:bg-[#16181D]'
            }`}
          >
            <span class="text-sm">📄</span> Digital Passport (PDF)
          </a>
        </nav>
      </div>

      <!-- Bottom Card & User Profile -->
      <div class="space-y-4 pt-4 border-t border-[#22252B]">
        <!-- Meiro Capacity Pill Card -->
        <div class="p-3 bg-[#16181D] border border-[#22252B] rounded-xl text-xs space-y-2">
          <div class="flex items-center justify-between text-[11px] text-text-muted">
            <span>Audit Compliance</span>
            <span class="text-lime font-bold">100%</span>
          </div>
          <div class="w-full h-1.5 bg-[#22252B] rounded-full overflow-hidden">
            <div class="h-full bg-lime rounded-full w-full"></div>
          </div>
          <p class="text-[10px] text-text-muted">Model: Calibrated XGBoost v1.0</p>
        </div>

        <!-- User Profile Pill -->
        <div class="flex items-center justify-between px-2 pt-1">
          <div class="flex items-center gap-2.5">
            <div class="w-8 h-8 rounded-full bg-lime text-black font-bold flex items-center justify-center text-xs">
              {applicantName.charAt(0)}
            </div>
            <div class="truncate max-w-[110px]">
              <p class="text-xs font-semibold text-white truncate">{applicantName}</p>
              <p class="text-[10px] text-text-muted truncate">{businessName}</p>
            </div>
          </div>
          <a href="/" class="text-text-muted hover:text-white text-xs">➔</a>
        </div>
      </div>
    </aside>

    <!-- Main Content Area -->
    <div class="flex-1 flex flex-col min-w-0">
      <!-- Topbar Header -->
      <header class="h-16 bg-[#0A0B0D]/80 backdrop-blur-md border-b border-[#22252B] px-6 flex items-center justify-between sticky top-0 z-40">
        <div class="flex items-center gap-4">
          <a href="/" class="md:hidden text-lg font-bold text-lime">✦</a>
          <h1 class="text-base font-bold text-white truncate">{title}</h1>
          <span class="hidden sm:inline-flex px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-positive/10 text-positive border border-positive/20">
            {statusBadge}
          </span>
        </div>

        <!-- Top Right Actions -->
        <div class="flex items-center gap-3">
          <!-- Persona Selector Dropdown -->
          <div class="flex items-center gap-1.5 bg-[#16181D] border border-[#22252B] rounded-full px-3 py-1 text-xs">
            <span class="text-text-muted hidden sm:inline">Persona:</span>
            <a href="?persona=ramesh" class="text-xs font-medium hover:text-lime transition-colors">Ramesh</a>
            <span class="text-text-muted">|</span>
            <a href="?persona=priya" class="text-xs font-medium hover:text-lime transition-colors">Priya</a>
            <span class="text-text-muted">|</span>
            <a href="?persona=arun" class="text-xs font-medium hover:text-lime transition-colors">Arun</a>
          </div>

          <a href="http://localhost:8000/api/reports/demo/download" target="_blank" class="btn-lime text-xs py-1.5 px-3.5 shadow-sm">
            <span>↓</span> Download Passport
          </a>
        </div>
      </header>

      <!-- Page Content -->
      <main class="flex-1 p-6 lg:p-8 max-w-7xl w-full mx-auto space-y-8">
        <slot />
      </main>
    </div>
  </body>
</html>
